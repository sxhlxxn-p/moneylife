{
  "name": "future-wallet-life",
  "version": "0.1.0",
  "private": true,
  "description": "머니 라이프 — 금융 미래 시뮬레이션 게임 개발 초안",
  "workspaces": [
    "Client",
    "Server",
    "Engine",
    "Shared",
    "Test"
  ],
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "npm run dev --workspace Client",
    "dev:server": "npm run dev --workspace Server",
    "dev:server:local": "python3 Server/run_local.py",
    "start": "npm run dev:client",
    "prototype": "node scripts/dev-server.cjs --prototype",
    "tree": "node scripts/print-tree.cjs",
    "test": "npm run test --workspace Test",
    "check": "npm run check --workspaces --if-present && node --check prototype/app.js && node --check prototype/engine.js && node --check scripts/dev-server.cjs && node --check scripts/print-tree.cjs",
    "demo:trading": "npm run demo:trading --workspace Engine",
    "setup:llm": "python3 Server/scripts/setup_llm.py",
    "check:llm": "python3 Server/scripts/check_llm.py",
    "check:market": "python3 Server/scripts/check_market.py",
    "prepare:market": "python3 Server/scripts/prepare_market_demo.py",
    "demo:monthly-trading": "npm run demo:monthly-trading --workspace Engine",
    "test:ui": "npm run test:ui --workspace Test",
    "db:migrate": "python3 Server/scripts/maintain_database.py migrate",
    "db:cleanup": "python3 Server/scripts/maintain_database.py cleanup",
    "format:client": "prettier --write \"Client/src/**/*.js\" \"Client/src/**/*.css\" Client/index.html",
    "format:check": "prettier --check \"Client/src/**/*.js\" \"Client/src/**/*.css\" Client/index.html",
    "check:ai:offline": "python3 Test/ai/check_offline.py",
    "prepare:ai": "python3 Test/ai/prepare.py",
    "evaluate:ai": "python3 Test/ai/evaluate.py",
    "review:ai": "python3 Test/ai/review_development.py"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
