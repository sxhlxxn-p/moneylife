# Server runtime
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Local PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=moneylife
POSTGRES_USER=moneylife
POSTGRES_PASSWORD=moneylife
DATABASE_URL=postgresql+psycopg://moneylife:moneylife@db:5432/moneylife

# For AWS, replace DATABASE_URL with the RDS endpoint and keep credentials in Secrets Manager.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@RDS_ENDPOINT:5432/moneylife?sslmode=require

# Secrets: keep real values in Server/.env only.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=

# Set LLM_MODEL to a model supporting Responses strict JSON Schema. No default model.

# Historical import; software permits only token issuance and daily candle reads.
# An access token may have broader provider permissions; never place it in Client.
TOSS_ACCESS_TOKEN=
# Only project-usable imported files appear in the catalog.
# MARKET_SERIES_DIR=/absolute/path/to/.data/market

# Alternatively issue a token at import time with server-side credentials.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Independent operator key (32+ characters) for GET /integrations/toss/status.
# Unset disables the endpoint. Never use Toss credentials as the operator key.
TOSS_OPERATOR_KEY=
# Share this persistent path between the API and check_market.py in deployments.
# TOSS_STATUS_FILE=/absolute/path/to/.data/toss-status.json

# Per-minute quotas shared through the database
AI_REQUESTS_PER_MINUTE=12
AI_IP_REQUESTS_PER_MINUTE=60
