# Server runtime
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Local PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=moneylife
POSTGRES_USER=moneylife
POSTGRES_PASSWORD=moneylife
DATABASE_URL=postgresql+psycopg://moneylife:moneylife@db:5432/moneylife

# For AWS, replace DATABASE_URL with the RDS endpoint and keep credentials in Secrets Manager.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@RDS_ENDPOINT:5432/moneylife?sslmode=require

# Secrets: keep real values in Server/.env only.
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=

# Set LLM_MODEL to a model supporting Responses strict JSON Schema. No default model.

# Optional offline historical import. Read-only token; never place in Client.
TOSS_ACCESS_TOKEN=
# Only project-usable imported files appear in the catalog.
# MARKET_SERIES_DIR=/absolute/path/to/.data/market
